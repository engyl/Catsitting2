<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Sugarplum Cat Pet Services — Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  /* Palette Extracted from Sugarplum Flyer */
  --twilight:#311b38;       /* Outer dark purple border/accents */
  --plum:#6b2d5c;            /* Rich banner/brand purple */
  --plum-hover:#522046;
  --gold:#d4af37;            /* Sparkle and accent gold */
  --parchment:#fdf6e7;       /* Warm background cream */
  --parchment-card:#fffbf3;  /* Inner card cream */
  --pink-border:#e2b6c7;     /* Soft floral pink border */
  --ink:#2d1a29;             /* Text color */
  --muted:#7a6375;
  --success:#2d7a52;
  --error:#b83232;
  --blue:#315d96;
  --sh-lg:0 12px 36px rgba(49,27,56,.25);
}

body{
  background: var(--twilight);
  font-family:'DM Sans',sans-serif;
  color:var(--ink);
  min-height:100vh;
  overflow-x:hidden;
  padding:20px 12px;
}

/* LANDING PAGE STYLES */
#landing-page{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  min-height:90vh;
  max-width:700px;
  margin:0 auto;
  text-align:center;
  background:var(--parchment-card);
  border:8px solid var(--pink-border);
  border-radius:28px;
  padding:40px 24px;
  box-shadow:var(--sh-lg);
  position:relative;
}

.logo-container{
  width:180px;
  height:180px;
  border-radius:50%;
  border:3px solid var(--gold);
  background:var(--twilight);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:20px;
  box-shadow:0 0 20px rgba(212,175,55,.4);
  overflow:hidden;
}

.logo-img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.landing-title{
  font-family:'Playfair Display',serif;
  font-size: clamp(2rem, 5vw, 2.8rem);
  color: var(--plum);
  margin-bottom: 6px;
}
.landing-subtitle{
  font-family:'Playfair Display',serif;
  font-style:italic;
  color:var(--gold);
  font-size:1.2rem;
  margin-bottom:20px;
}
.landing-desc{
  font-size:0.98rem;
  line-height:1.6;
  color:var(--ink);
  max-width:520px;
  margin-bottom:32px;
}
.btn-start{
  background:linear-gradient(135deg, var(--plum), var(--twilight));
  color:#fff;
  border:2px solid var(--gold);
  padding:16px 48px;
  font-size:1.1rem;
  font-weight:600;
  border-radius:40px;
  cursor:pointer;
  transition:all .2s ease;
  box-shadow:0 6px 20px rgba(107,45,92,.4);
}
.btn-start:hover{
  transform:scale(1.04);
  box-shadow:0 8px 25px rgba(107,45,92,.6);
}

/* APP WORKSPACE CONTAINER */
#app-workspace{
  display:none; /* Hidden by default until "Start" is clicked */
  max-width:820px;
  margin:0 auto;
}

/* HEADER */
header{text-align:center;padding:20px 0 28px}
header h1{font-family:'Playfair Display',serif;font-size:clamp(1.9rem,5vw,2.8rem);font-weight:700;color:var(--parchment);letter-spacing:-.02em}
header h1 em{font-style:italic;color:var(--gold)}
header p{margin-top:4px;font-size:.82rem;color:var(--pink-border);letter-spacing:.08em;text-transform:uppercase}

/* CARD */
.card{background:var(--parchment-card);border-radius:22px;box-shadow:var(--sh-lg);margin-bottom:20px;padding:28px 32px;border:2px solid var(--pink-border)}
.section-label{font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:var(--plum);letter-spacing:.02em;margin-bottom:13px;padding-bottom:7px;border-bottom:1.5px solid var(--pink-border);display:flex;align-items:center;gap:7px}
.form-section{margin-bottom:20px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px 15px}
.field{display:flex;flex-direction:column;gap:5px}
label.fl{font-size:.72rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
input,select,textarea{width:100%;background:var(--parchment);border:1.5px solid var(--pink-border);border-radius:10px;padding:10px 13px;font-family:'DM Sans',sans-serif;font-size:.92rem;color:var(--ink);outline:none;transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{border-color:var(--plum);box-shadow:0 0 0 3px rgba(107,45,92,.15)}
input[readonly]{background:#ebd8c3;color:var(--muted);cursor:default}
.select-wrap{position:relative}
.select-wrap::after{content:'▾';position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none}
.select-wrap select{padding-right:34px;cursor:pointer}

/* DYNAMIC CLICKABLE ACTIVITY CHIPS */
.activities-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.ac{
  display:flex;
  align-items:center;
  gap:8px;
  background:var(--parchment);
  border:2px solid var(--pink-border);
  border-radius:14px;
  padding:10px 14px;
  cursor:pointer;
  user-select:none;
  transition:all .2s ease;
}
.ac input[type=checkbox]{
  display:none;
}
.ac .ac-icon{
  font-size:1.2rem;
  transition:transform .2s ease;
}
.ac .ac-text{
  font-size:.86rem;
  font-weight:600;
  color:var(--ink);
  flex-grow:1;
}
.ac .ac-status{
  font-size:.75rem;
  opacity:0;
  transition:opacity .2s ease;
  color:var(--gold);
}

.ac.selected{
  background:var(--plum);
  border-color:var(--gold);
  box-shadow:0 4px 12px rgba(107,45,92,.3);
  transform:translateY(-2px);
}
.ac.selected .ac-text{
  color:#fff;
}
.ac.selected .ac-icon{
  transform:scale(1.15);
}
.ac.selected .ac-status{
  opacity:1;
}

textarea{resize:vertical;min-height:76px}
#dur-badge{display:none;background:rgba(107,45,92,.1);border:1px solid var(--plum);color:var(--plum);font-size:.79rem;font-weight:600;padding:4px 12px;border-radius:20px;margin-top:6px;width:fit-content}

/* BUTTONS */
.btn-create-vo,.submit-btn{background:var(--plum);color:#fff;border:none;border-radius:10px;padding:10px 20px;font-weight:600;cursor:pointer;transition:background .2s}
.btn-create-vo:hover,.submit-btn:hover{background:var(--plum-hover)}
.submit-btn{width:100%;padding:14px;font-size:1rem;border-radius:12px;box-shadow:0 4px 12px rgba(107,45,92,.3)}
.btn-vo{display:inline-flex;align-items:center;gap:5px;border:none;border-radius:8px;padding:8px 15px;font-size:.8rem;font-weight:600;cursor:pointer}
.btn-complete{background:rgba(45,122,82,.15);color:var(--success)}
.btn-complete.done{background:var(--success);color:#fff}
.btn-delete-vo{background:rgba(184,50,50,.12);color:var(--error)}

/* BACK BUTTON STYLES */
.navigation-bar {
  display: flex;
  justify-content: center;
  margin-top: 30px;
  margin-bottom: 20px;
}

.btn-back {
  background: var(--parchment-card);
  color: var(--plum);
  border: 2px solid var(--pink-border);
  padding: 12px 32px;
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: 30px;
  cursor: pointer;
  transition: all .2s ease;
  box-shadow: var(--sh-lg);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-back:hover {
  background: var(--plum);
  color: #fff;
  border-color: var(--gold);
  transform: translateY(-2px);
}

/* STATUS & BADGES */
.status-pill{display:inline-flex;align-items:center;gap:5px;font-size:.75rem;font-weight:600;padding:3px 10px;border-radius:20px}
.status-active{background:rgba(49,93,150,.12);color:var(--blue)}
.status-done{background:rgba(45,122,82,.15);color:var(--success)}
.badge{display:inline-block;background:rgba(107,45,92,.12);color:var(--plum);border-radius:20px;padding:2px 7px;font-size:.71rem;font-weight:600;margin:2px}
.cnt{background:var(--plum);color:#fff;font-size:.68rem;font-weight:600;padding:1px 6px;border-radius:20px;margin-left:4px}

/* TABLE & TABS */
.vo-tabs{display:flex;gap:0;border-bottom:1.5px solid var(--pink-border);overflow-x:auto;margin-bottom:12px}
.vo-tab{padding:10px 16px;font-size:.8rem;font-weight:600;color:var(--muted);cursor:pointer;border:none;background:none;border-bottom:2.5px solid transparent;white-space:nowrap;transition:all .2s ease}
.vo-tab:hover{color:var(--plum)}
.vo-tab.active{color:var(--plum);border-bottom-color:var(--plum)}
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.82rem}
thead{background:rgba(107,45,92,.08)}
thead th{padding:9px 13px;text-align:left;font-weight:600;font-size:.71rem;text-transform:uppercase;color:var(--plum);white-space:nowrap}
tbody tr{border-bottom:1px solid var(--pink-border)}
tbody td{padding:10px 13px;vertical-align:top}

/* TOAST */
#toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--twilight);color:#fff;padding:11px 24px;border-radius:40px;font-size:.86rem;font-weight:500;box-shadow:var(--sh-lg);transition:all .35s ease;opacity:0;z-index:999}
#toast.show{transform:translateX(-50%) translateY(0);opacity:1}
#toast.success{background:var(--success)}
#toast.error{background:var(--error)}

@media(max-width:600px){
  .grid-2{grid-template-columns:1fr}
  .card{padding:20px 16px}
}
</style>
</head>
<body>

<!-- ═══════════════════════════════════════════ -->
<!--  LANDING PAGE                              -->
<!-- ═══════════════════════════════════════════ -->
<div id="landing-page">
  <div class="logo-container">
    <img src="data:image/png;base64," alt="Sugarplum Cat Pet Services Logo" class="logo-img"/>
  </div>
  <h1 class="landing-title">Sugarplum Cat Pet Services</h1>
  <p class="landing-subtitle">Comfort without Compromise</p>
  
  <p class="landing-desc">
    Welcome to the official Sugarplum Pet Sitting Activity Tracker. This application allows sitters to manage visit orders, keep structured duration logs, record performed cat-care activities, and instantly upload completed visit observations directly to the cloud.
  </p>

  <button class="btn-start" id="start-btn">Start Logging Activities 🐾</button>
</div>

<!-- ═══════════════════════════════════════════ -->
<!--  APP WORKSPACE                             -->
<!-- ═══════════════════════════════════════════ -->
<div id="app-workspace">
  <header>
    <h1>Sugar<em>plum</em></h1>
    <p>Cat Sitting Activity Tracker</p>
  </header>

  <!-- VISIT ORDER CARD -->
  <div class="card" id="vo-card">
    <div class="section-label">📋 Visit Orders</div>

    <div class="form-section">
      <div class="grid-2">
        <div class="field">
          <label class="fl">New Visit Order Name</label>
          <input type="text" id="vo-name-input" placeholder="e.g. Whiskers @ Tanjong Pagar"/>
        </div>
        <div class="field">
          <label class="fl">Customer Address</label>
          <input type="text" id="vo-addr-input" placeholder="e.g. 12 Orchard Rd, Singapore"/>
        </div>
      </div>
      <button class="btn-create-vo" id="btn-create-vo" style="margin-top:12px">+ Create Visit Order</button>
    </div>

    <div class="field">
      <label class="fl">Select Active Visit Order</label>
      <div class="select-wrap">
        <select id="vo-select">
          <option value="">— Select a Visit Order —</option>
        </select>
      </div>
    </div>

    <div id="vo-addr-display" style="display:none;margin-top:12px">
      <label class="fl">Address on file</label>
      <input type="text" id="vo-addr-readonly" readonly/>
    </div>

    <div class="vo-actions" id="vo-actions" style="display:none;margin-top:12px;gap:8px">
      <button class="btn-vo btn-complete" id="btn-complete-vo">✓ Mark Completed</button>
      <button class="btn-vo btn-delete-vo" id="btn-delete-vo">🗑 Delete Visit Order</button>
    </div>
  </div>

  <!-- VISIT LOG FORM CARD -->
  <div class="card" id="log-card">
    <div id="no-vo-msg" style="text-align:center;color:var(--muted);font-style:italic">
      Please create or select a Visit Order above to log a visit.
    </div>
    
    <div id="log-form-inner" style="display:none">
      <form id="log-form">
        <div class="form-section">
          <div class="section-label">🏠 Customer Details</div>
          <div class="grid-2">
            <div class="field">
              <label class="fl">Visit Order</label>
              <input type="text" id="vo-display" readonly tabindex="-1"/>
            </div>
            <div class="field">
              <label class="fl">Address</label>
              <input type="text" id="address-display" readonly tabindex="-1"/>
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="section-label">🕐 Visit Timing</div>
          <div class="grid-2">
            <div class="field">
              <label class="fl">Arrival Date &amp; Time *</label>
              <input type="datetime-local" id="arrival"/>
            </div>
            <div class="field">
              <label class="fl">Departure Date &amp; Time *</label>
              <input type="datetime-local" id="departure"/>
            </div>
          </div>
          <div id="dur-badge">Duration: <span id="dur-text"></span></div>
        </div>

        <div class="form-section">
          <div class="section-label">🐱 Activities Performed</div>
          <div class="field" style="margin-bottom:12px">
            <label class="fl">Visit Type</label>
            <div class="select-wrap">
              <select id="visit-type">
                <option value="">— Select visit type —</option>
                <option>Drop-in (30-45 min)</option>
                <option>Extended visit (1 hr)</option>
                <option>Half-day stay</option>
                <option>Overnight stay</option>
                <option>Vet Visit Transport</option>
              </select>
            </div>
          </div>
          
          <!-- ACTIVITY CHIPS WITH SELECTION STATE -->
          <div class="activities-grid">
            <label class="ac">
              <input type="checkbox" value="Feeding"/>
              <span class="ac-icon">🥣</span>
              <span class="ac-text">Feeding</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Fresh Water"/>
              <span class="ac-icon">💧</span>
              <span class="ac-text">Fresh Water</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Litter Clean"/>
              <span class="ac-icon">🧹</span>
              <span class="ac-text">Litter Clean</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Playtime"/>
              <span class="ac-icon">🧶</span>
              <span class="ac-text">Playtime</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Grooming"/>
              <span class="ac-icon">🪮</span>
              <span class="ac-text">Grooming</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Cuddle Time"/>
              <span class="ac-icon">😻</span>
              <span class="ac-text">Cuddle Time</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Medication"/>
              <span class="ac-icon">💊</span>
              <span class="ac-text">Medication</span>
              <span class="ac-status">✓</span>
            </label>
            <label class="ac">
              <input type="checkbox" value="Health Check"/>
              <span class="ac-icon">🩺</span>
              <span class="ac-text">Health Check</span>
              <span class="ac-status">✓</span>
            </label>
          </div>
        </div>

        <div class="form-section">
          <div class="section-label">📝 Notes &amp; Observations</div>
          <div class="field">
            <textarea id="notes" placeholder="Mood, appetite, special observations..."></textarea>
          </div>
        </div>

        <button type="submit" class="submit-btn">🐾 &nbsp;Save Visit Log</button>
      </form>
    </div>
  </div>

  <!-- RECORDS CARD -->
  <div class="card">
    <div class="section-label">📋 Saved Visit Logs</div>
    
    <!-- VISIT ORDER FILTER TABS -->
    <div class="vo-tabs" id="vo-tabs"></div>

    <div class="tbl-wrap">
      <table>
        <thead>
          <tr><th>#</th><th>Visit Order</th><th>Arrival</th><th>Departure</th><th>Duration</th><th>Type</th><th>Activities</th><th>Notes</th></tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- PAGE NAVIGATION AT BOTTOM -->
  <div class="navigation-bar">
    <button class="btn-back" id="back-btn">← Back to Home</button>
  </div>
</div>

<div id="toast"></div>

<script>
// Paste Google Script Web App URL here
const GOOGLE_SCRIPT_URL = "YOUR_GOOGLE_APPS_SCRIPT_URL_HERE";

// NAVIGATION LOGIC
document.getElementById('start-btn').addEventListener('click', function() {
  document.getElementById('landing-page').style.display = 'none';
  document.getElementById('app-workspace').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

document.getElementById('back-btn').addEventListener('click', function() {
  document.getElementById('app-workspace').style.display = 'none';
  document.getElementById('landing-page').style.display = 'flex';
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

// CLICK LISTENER TO TOGGLE VISUAL STATE OF ACTIVITY CHIPS
document.querySelectorAll('.ac').forEach(function(chip) {
  var checkbox = chip.querySelector('input[type="checkbox"]');
  chip.addEventListener('click', function() {
    if (checkbox.checked) {
      chip.classList.add('selected');
    } else {
      chip.classList.remove('selected');
    }
  });
});

// APPLICATION LOGIC & STORAGE
var VO_KEY  = 'sugarplum_visitorders';
var LOG_KEY = 'sugarplum_logs';
var visitOrders = [], logs = [], activeVoId = null, activeTab = 'all';

function loadData() {
  try { visitOrders = JSON.parse(localStorage.getItem(VO_KEY)) || []; } catch(e){ visitOrders=[]; }
  try { logs = JSON.parse(localStorage.getItem(LOG_KEY)) || []; } catch(e){ logs=[]; }
}
function saveData() {
  localStorage.setItem(VO_KEY, JSON.stringify(visitOrders));
  localStorage.setItem(LOG_KEY, JSON.stringify(logs));
}

function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,6); }
function toISO(d) {
  var p = function(n){ return String(n).padStart(2,'0'); };
  return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());
}

function esc(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function showToast(msg, type) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'show ' + (type||'');
  clearTimeout(t._tid);
  t._tid = setTimeout(function(){ t.className=''; }, 3200);
}

// RENDER VO SELECT & FILTER TABS
function renderVOSelect() {
  var sel = document.getElementById('vo-select');
  sel.innerHTML = '<option value="">— Select a Visit Order —</option>';
  visitOrders.forEach(function(vo) {
    var opt = document.createElement('option');
    opt.value = vo.id;
    opt.textContent = vo.name + (vo.status==='completed' ? ' [Completed]' : '');
    sel.appendChild(opt);
  });
}

function renderVOTabs() {
  var tabs = document.getElementById('vo-tabs');
  var html = '<button class="vo-tab'+(activeTab==='all'?' active':'')+'" data-tab="all">All <span class="cnt">'+logs.length+'</span></button>';
  
  visitOrders.forEach(function(vo){
    var cnt = logs.filter(function(l){ return l.voId===vo.id; }).length;
    html += '<button class="vo-tab'+(activeTab===vo.id?' active':'')+'" data-tab="'+vo.id+'">'+
            esc(vo.name)+' <span class="cnt">'+cnt+'</span></button>';
  });
  tabs.innerHTML = html;

  tabs.querySelectorAll('.vo-tab').forEach(function(btn){
    btn.addEventListener('click', function(){
      activeTab = this.getAttribute('data-tab');
      renderVOTabs();
      renderLogsTable();
    });
  });
}

document.getElementById('btn-create-vo').addEventListener('click', function(){
  var name = document.getElementById('vo-name-input').value.trim();
  var addr = document.getElementById('vo-addr-input').value.trim();
  if (!name || !addr) { showToast('Please enter name and address','error'); return; }
  var vo = { id: uid(), name: name, address: addr, status: 'active' };
  visitOrders.push(vo);
  saveData();
  document.getElementById('vo-name-input').value = '';
  document.getElementById('vo-addr-input').value = '';
  renderVOSelect();
  renderVOTabs();
  selectVO(vo.id);
  showToast('Visit Order created!','success');
});

document.getElementById('vo-select').addEventListener('change', function(){ selectVO(this.value); });

function selectVO(id) {
  activeVoId = id || null;
  var vo = visitOrders.find(function(v){ return v.id === id; });
  var addrDisplay = document.getElementById('vo-addr-display');
  var voActions   = document.getElementById('vo-actions');
  var logInner    = document.getElementById('log-form-inner');
  var noVoMsg     = document.getElementById('no-vo-msg');

  if (!vo) {
    addrDisplay.style.display = voActions.style.display = logInner.style.display = 'none';
    noVoMsg.style.display = 'block';
    return;
  }

  document.getElementById('vo-addr-readonly').value = vo.address;
  addrDisplay.style.display = 'block';
  voActions.style.display = 'flex';

  var btnComplete = document.getElementById('btn-complete-vo');
  if (vo.status === 'completed') {
    btnComplete.textContent = '✓ Completed';
    btnComplete.classList.add('done');
    btnComplete.disabled = true;
  } else {
    btnComplete.textContent = '✓ Mark Completed';
    btnComplete.classList.remove('done');
    btnComplete.disabled = false;
  }

  if (vo.status === 'completed') {
    logInner.style.display = 'none';
    noVoMsg.style.display = 'block';
    noVoMsg.textContent = 'This Visit Order is completed.';
  } else {
    logInner.style.display = 'block';
    noVoMsg.style.display = 'none';
    document.getElementById('vo-display').value = vo.name;
    document.getElementById('address-display').value = vo.address;
    if (!document.getElementById('arrival').value) {
      document.getElementById('arrival').value = toISO(new Date());
    }
  }
}

// VISIT ORDER ACTIONS (MARK COMPLETED & DELETE)
document.getElementById('btn-complete-vo').addEventListener('click', function(){
  if (activeVoId) completeVO(activeVoId);
});

document.getElementById('btn-delete-vo').addEventListener('click', function(){
  if (activeVoId) deleteVO(activeVoId);
});

function completeVO(id) {
  var vo = visitOrders.find(function(v){ return v.id === id; });
  if (!vo) return;
  if (!confirm('Mark "'+vo.name+'" as Completed? You won\'t be able to add new logs to it.')) return;
  vo.status = 'completed';
  saveData();
  renderVOSelect();
  renderVOTabs();
  selectVO(id);
  showToast(vo.name + ' marked as Completed','success');
}

function deleteVO(id) {
  var vo = visitOrders.find(function(v){ return v.id === id; });
  if (!vo) return;
  var logCount = logs.filter(function(l){ return l.voId === id; }).length;
  var msg = 'Delete Visit Order "'+vo.name+'"?';
  if (logCount) msg += '\nThis will also delete ' + logCount + ' visit log(s).';
  if (!confirm(msg)) return;
  visitOrders = visitOrders.filter(function(v){ return v.id !== id; });
  logs = logs.filter(function(l){ return l.voId !== id; });
  if (activeTab === id) activeTab = 'all';
  saveData();
  activeVoId = null;
  document.getElementById('vo-select').value = '';
  selectVO(null);
  renderVOSelect();
  renderVOTabs();
  renderLogsTable();
  showToast('Visit Order deleted');
}

// LOG FORM SUBMISSION
document.getElementById('log-form').addEventListener('submit', function(e){
  e.preventDefault();
  var vo = visitOrders.find(function(v){ return v.id===activeVoId; });
  if (!vo) return;

  var arrivalVal   = document.getElementById('arrival').value;
  var departureVal = document.getElementById('departure').value;
  var visitTypeVal = document.getElementById('visit-type').value;
  var notesVal     = document.getElementById('notes').value.trim();

  var checked = [];
  document.querySelectorAll('.activities-grid input[type=checkbox]:checked').forEach(function(cb){
    checked.push(cb.value);
  });

  if (!arrivalVal || !departureVal) { showToast('Set arrival and departure times','error'); return; }

  var diffMin = (new Date(departureVal) - new Date(arrivalVal)) / 60000;
  var dh = Math.floor(diffMin/60), dm = Math.round(diffMin%60);
  var durationVal = dh > 0 ? (dh+'h '+dm+'m') : (dm+' min');

  var log = {
    id: uid(), voId: vo.id, voName: vo.name, address: vo.address,
    timestamp: new Date().toLocaleString(), arrival: arrivalVal.replace('T',' '),
    departure: departureVal.replace('T',' '), duration: durationVal,
    visitType: visitTypeVal, activities: checked.join(', '), notes: notesVal
  };

  if (GOOGLE_SCRIPT_URL && GOOGLE_SCRIPT_URL !== "YOUR_GOOGLE_APPS_SCRIPT_URL_HERE") {
    fetch(GOOGLE_SCRIPT_URL, {
      method: "POST", mode: "no-cors",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(log)
    });
  }

  logs.push(log);
  saveData();
  renderVOTabs();
  renderLogsTable();

  // Reset selected activities UI
  document.querySelectorAll('.ac').forEach(function(chip){
    chip.classList.remove('selected');
    chip.querySelector('input[type="checkbox"]').checked = false;
  });

  showToast('Visit log saved!','success');
});

function filteredLogs() {
  if (activeTab === 'all') return logs;
  return logs.filter(function(l){ return l.voId === activeTab; });
}

function renderLogsTable() {
  var fl = filteredLogs();
  var tbody = document.getElementById('tbody');
  if (!fl.length) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:var(--muted)">No logs recorded yet for this selection.</td></tr>';
    return;
  }
  var html = '';
  fl.slice().reverse().forEach(function(r, i){
    html += '<tr>';
    html += '<td>'+(fl.length-i)+'</td>';
    html += '<td><strong>'+esc(r.voName)+'</strong></td>';
    html += '<td>'+esc(r.arrival)+'</td>';
    html += '<td>'+esc(r.departure)+'</td>';
    html += '<td>'+esc(r.duration)+'</td>';
    html += '<td><span class="badge">'+esc(r.visitType||'—')+'</span></td>';
    html += '<td>'+esc(r.activities)+'</td>';
    html += '<td>'+esc(r.notes)+'</td>';
    html += '</tr>';
  });
  tbody.innerHTML = html;
}

window.addEventListener('DOMContentLoaded', function(){
  loadData();
  renderVOSelect();
  renderVOTabs();
  renderLogsTable();
});
</script>
</body>
</html>
